{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PytDeb",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "pythonArgs": [
        "-Xfrozen_modules=off"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
      },
      "justMyCode": false
    },
    {
      "name": "ViewTester",
      "type": "debugpy",
      "request": "launch",
      "module": "pyG5.pyG5ViewTester",
      "justMyCode": true
    },
    {
      "name": "App",
      "type": "debugpy",
      "request": "launch",
      "module": "pyG5.pyG5Main",
      "args": [
        "-v"
      ],
      "justMyCode": false
    }
  ]
}